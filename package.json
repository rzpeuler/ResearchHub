{
  "name": "researchhub-lite",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "client:typecheck": "tsc --noEmit -p client/tsconfig.json",
    "client:build": "vite build --config client/vite.config.ts",
    "client:watch": "vite build --watch --config client/vite.config.ts",
    "client:test": "vitest run --config client/vitest.config.ts",
    "researchhub/runtime": "tsx app/runtime/cli.ts",
    "researchhub": "npm run client:build && npm run researchhub/runtime",
    "brief:morning": "tsx scripts/daily-brief-cli.ts morning",
    "brief:evening": "tsx scripts/daily-brief-cli.ts evening",
    "acceptance:unified-research": "tsx scripts/acceptance-unified-research.ts",
    "acceptance:unified-research-closure": "tsx scripts/acceptance-unified-research-closure.ts",
    "acceptance:unified-research-final-fix": "tsx scripts/acceptance-unified-research-final-fix.ts",
    "acceptance:knowledge-v04": "tsx scripts/acceptance-knowledge-v04.ts",
    "acceptance:knowledge-v04-final": "tsx scripts/acceptance-knowledge-v04-final.ts",
    "acceptance:knowledge-topic-workspace": "tsx scripts/acceptance-knowledge-topic-workspace.ts",
    "test": "npm run client:test && npm run test:node",
    "test:node": "node tests/run-node-tests.mjs",
    "document-parser:check": "node scripts/document-parser-runtime.mjs --check",
    "document-parser:setup": "node scripts/document-parser-runtime.mjs --setup",
    "acceptance:expectation-source-001c": "tsx scripts/acceptance-expectation-source-001c-real.ts",
    "acceptance:earnings-expectations-d1-real": "tsx scripts/acceptance-earnings-expectations-d1-real.ts",
    "acceptance:management-communication-d2-003-real": "tsx scripts/acceptance-management-communication-d2-003-real.ts",
    "acceptance:valuation-basis-d3-real": "tsx scripts/acceptance-valuation-basis-evidence-d3-real.ts",
    "acceptance:auto-comps-d3-real": "tsx scripts/acceptance-auto-comps-d3-real.ts",
    "acceptance:industry-operating-observations-d4-real": "tsx scripts/acceptance-industry-operating-observations-d4-real.ts",
    "acceptance:daily-breadth-d5-real": "tsx scripts/acceptance-daily-breadth-d5-real.ts",
    "acceptance:thesis-lifecycle-invalidation-real": "tsx scripts/acceptance-thesis-lifecycle-invalidation-real.ts"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "22.15.21",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "tsx": "4.19.2",
    "typescript": "5.8.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@xyflow/react": "^12.11.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
