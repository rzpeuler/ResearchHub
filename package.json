    "typecheck:integration": "tsc --noEmit -p tsconfig.json",
    "test:runtime": "tsx --test dsh/llm-runtime/skill-adapter.test.ts tests/runtime/equity-research-runtime.test.ts",
    "test:news-real": "tsx --test tests/integration/news-plugin-real.test.ts",
    "test:news-acquisition": "tsx --test tests/integration/news-acquisition.test.ts",
    "test:official-news-real": "tsx --test tests/integration/news-provider-real.test.ts",
    "test:financial-real": "tsx --test tests/integration/financial-plugin-real.test.ts",
    "test:akshare-financial-real": "tsx --test tests/integration/akshare-financial-real.test.ts",
    "test:real-equity-pipeline": "tsx --test tests/integration/real-equity-research-pipeline.test.ts",
    "test": "npm run typecheck:integration && npm run test:plugins && npm run test:plugin-operations && npm run test:workflows && npm run test:artifacts && npm run test:schemas && npm run test:evaluation && npm run test:memory && npm run test:skills && npm run test:knowledge && npm run test:knowledge-curation && npm run test:knowledge-ingestion && npm run test:knowledge-infrastructure && npm run test:knowledge-migration && npm run test:knowledge-product-validation && npm run test:integration"
  },
