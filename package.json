    "test:knowledge-ingestion": "tsx --test tests/knowledge/ingestion/research-report-ingestion.test.ts",
    "test:knowledge-infrastructure": "tsx --test tests/knowledge/runtime/data-root.test.ts tests/knowledge/runtime/compatibility.test.ts tests/knowledge/runtime/manifest-loader.test.ts tests/knowledge/runtime/canonical-registry.test.ts tests/knowledge/runtime/registry.test.ts tests/knowledge/runtime/loader.test.ts tests/knowledge/runtime/legacy-compatibility.test.ts tests/knowledge/runtime/raw-archive.test.ts tests/knowledge/runtime/changeset.test.ts tests/knowledge/runtime/writer.test.ts tests/knowledge/runtime/dependency-boundary.test.ts",
